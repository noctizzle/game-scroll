<?xml version="1.0" encoding="utf-8"?>
<!-- No Android backup or phone-to-phone copy of the app's data. Progress moves to a new phone through
     the Play Games cloud save instead; a copied install would carry this phone's anonymous device id,
     and two phones sharing one id would undercount wins and credits when their saves merge. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
